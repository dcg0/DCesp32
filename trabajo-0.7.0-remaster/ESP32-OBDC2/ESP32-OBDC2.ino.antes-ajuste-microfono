cfg.forEach(p=>{h+='<label>'+p.n+' <input id=w_'+p.id+' type=number step=any value="'+c.warn[p.id]+'" style="width:80px"></label>'});
h+='<br><label>Voltaje bajo (V) <input id=cvb type=number step=any value="'+c.vb+'" style="width:80px"></label>'
+'<br><label>Velocidad <select id=cuv><option value=0>km/h<option value=1>mph</select></label>'
+'<label>Temp <select id=cut><option value=0>°C<option value=1>°F</select></label>'
+'<label>Presión <select id=cup><option value=0>kPa<option value=1>psi</select></label>'
+'<br><label>Adaptador BT <input id=cad value="'+c.ad+'" maxlength=23></label>'
+'<br><label>WiFi <input id=css value="'+c.ssid+'" maxlength=32></label><label>Clave <input id=cpw type=password placeholder="(sin cambios)" maxlength=32></label>'
+'<br><button onclick="cfgGuardar()">Guardar</button><button onclick="cfgReset()">Restablecer</button><button onclick="reiniciar()">Reiniciar ESP32</button><pre id=cmsg></pre>';
