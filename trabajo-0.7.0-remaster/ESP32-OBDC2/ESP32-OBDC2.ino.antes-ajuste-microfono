<script>
const E=["Desconectado","Conectando…","Inicializando…","Conectado","Sin respuesta del auto"];let cfg=[];
function $(i){return document.getElementById(i)}
let pg=$('pages'),cur=0,N=5;
function go(i){i=Math.max(0,Math.min(N-1,i));pg.scrollTo({left:i*pg.clientWidth,behavior:'smooth'})}
function mark(){if(!pg.clientWidth)return;cur=Math.max(0,Math.min(N-1,Math.round(pg.scrollLeft/pg.clientWidth)));document.querySelectorAll('.navtab').forEach((x,k)=>{x.classList.toggle('on',k===cur);x.setAttribute('aria-current',k===cur?'page':'false')});document.querySelectorAll('#dots button').forEach((x,k)=>x.classList.toggle('on',k===cur));try{localStorage.setItem('dcpg',cur)}catch(e){}if(cur===1&&!gPaus&&gInit)gDib()}
function initSwipe(){document.querySelectorAll('#dots button').forEach((x,k)=>x.onclick=()=>go(k));pg.addEventListener('scroll',()=>{clearTimeout(pg._mt);pg._mt=setTimeout(mark,70)});document.addEventListener('keydown',e=>{if(e.key==='ArrowRight')go(cur+1);if(e.key==='ArrowLeft')go(cur-1)});try{const q=parseInt(localStorage.getItem('dcpg'));if(q>=0&&q<N)pg.scrollLeft=q*pg.clientWidth}catch(e){}mark()}
async function init(){cfg=await(await fetch('/cfg')).json();
