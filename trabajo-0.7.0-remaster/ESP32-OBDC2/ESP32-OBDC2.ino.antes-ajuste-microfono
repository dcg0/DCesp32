async function tick(){try{const j=await(await fetch('/data',{cache:'no-store'})).json();try{alimenta(j)}catch(e){}
$('st').textContent=(E[j.bt]||'Estado desconocido')+' · '+j.pps+' PID/s · Adaptador ELM327';$('st').className=j.bt==3?'ok':'';
cfg.forEach(p=>{const v=j.d[p.id],c=$('c_'+p.id);if(!c)return;const r=cv(p,v);c.querySelector('b').textContent=r[0];c.querySelectorAll('small')[1].textContent=r[1];
c.className='c'+(v!=null&&p.w>0&&v>=p.w?' w':'')})}
catch(e){$('st').textContent='Sin enlace con el ESP32';$('st').className=''}setTimeout(tick,400)}
async function refrescaEstado(){try{const s=await(await fetch('/status',{cache:'no-store'})).json();$('btState').textContent=E[s.bt]||'Desconocido';$('fw').textContent=s.fw||'--';$('pps').textContent=(s.pps==null?'--':s.pps)+' PID/s';$('up').textContent=s.up==null?'--':Math.floor(s.up/60)+' min';$('heap').textContent=s.heap==null?'--':Math.round(s.heap/1024)+' KB'}catch(e){$('btState').textContent='Sin conexión'}}
async function actualizaVehiculo(){try{const v=await(await fetch('/vehiculo',{cache:'no-store'})).json();$('vehEstado').textContent=v.estado||'--';$('vin').textContent=v.vin||'Aún no leído';$('vehProtocolo').textContent=v.protocolo||'--';$('vehVoltaje').textContent=v.voltaje==null?'--':v.voltaje+' V'}catch(e){}}
function pintaLista(id,items){const ul=$(id);ul.textContent='';if(!items||!items.length){const li=document.createElement('li');li.textContent='Sin códigos en esta categoría';ul.appendChild(li);return}items.forEach(x=>{const li=document.createElement('li');li.textContent=(x.c||x.codigo||'Código')+(x.d||x.descripcion?' — '+(x.d||x.descripcion):'');ul.appendChild(li)})}
async function actualizaDtc(){try{const j=await(await fetch('/dtc',{cache:'no-store'})).json();$('dtcEstado').textContent=j.estado||'--';$('mil').textContent=j.mil==null?'--':(j.mil?'Encendida':'Apagada');$('dtcCuenta').textContent=j.cuenta==null?'--':j.cuenta;pintaLista('dtcAlmacenados',j.almacenados);pintaLista('dtcPendientes',j.pendientes);pintaLista('dtcPermanentes',j.permanentes)}catch(e){$('dtcEstado').textContent='No se pudo leer el resultado'}}
async function leerDtc(){dtcLeido=true;$('dtcEstado').textContent='Solicitando lectura al vehículo…';try{await fetch('/dtc/leer',{method:'POST'});setTimeout(actualizaDtc,700)}catch(e){$('dtcEstado').textContent='No se pudo iniciar la lectura'}}
async function leerVin(){$('vehEstado').textContent='Solicitando VIN…';try{await fetch('/vehiculo/leer',{method:'POST'});setTimeout(actualizaVehiculo,900)}catch(e){$('vehEstado').textContent='No se pudo iniciar la lectura'}}
async function borrarDtc(){if(!confirm('ADVERTENCIA: apaga la MIL y reinicia monitores de preparación. Se recomienda motor apagado y contacto ON. ¿Confirmas BORRAR?'))return;const r=await fetch('/dtc/borrar',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'confirmar=BORRAR'});$('diag').textContent=await r.text()}
let U={uv:0,ut:0,up:0},ocultoKey='',prevKey='';
function cv(p,v){if(v==null)return['--',p.u];const k=p.u;
if(k=='km/h'&&U.uv)return[(v*0.621371).toFixed(0),'mph'];
if(k=='°C'&&U.ut)return[(v*9/5+32).toFixed(1),'°F'];
if(k=='kPa'&&U.up)return[(v*0.145038).toFixed(1),'psi'];
return[v,k]}
async function cargaU(){try{U=await(await fetch('/config')).json()}catch(e){}}
function beep(){try{const a=new(window.AudioContext||window.webkitAudioContext)(),o=a.createOscillator();o.frequency.value=880;o.connect(a.destination);o.start();setTimeout(()=>{o.stop();a.close()},250)}catch(e){}}
function silenciar(){ocultoKey=prevKey;$('al').innerHTML=''}
async function alertas(){try{const j=await(await fetch('/alertas')).json();
const key=j.a.map(x=>x.id+x.nv).join(',');
if(!j.a.length){$('al').innerHTML='';prevKey='';ocultoKey=''}
else{if(key!=prevKey){prevKey=key;ocultoKey='';try{navigator.vibrate&&navigator.vibrate([200,100,200])}catch(e){}beep()}
if(key!=ocultoKey)$('al').innerHTML=j.a.map(x=>{const p=x.p&&cfg.find(c=>c.id==x.p);const r=(p&&x.v!=null)?' · '+cv(p,x.v).join(' '):'';return'<div class="a'+x.nv+'">'+x.n+' '+x.t+r+'</div>'}).join('')+'<button onclick="silenciar()">Entendido</button>'}
}catch(e){}setTimeout(alertas,1000)}
async function cfgAbrir(){const c=await(await fetch('/config')).json();U=c;
