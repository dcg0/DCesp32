x.strokeStyle=x.fillStyle=COL[k];
if(vs.length<2){x.fillText(p.n+': sin datos',8,ly);ly+=18;return}
let lo=Math.min(...vs),hi=Math.max(...vs);if(p.w>0){lo=Math.min(lo,p.w);hi=Math.max(hi,p.w)}if(hi==lo)hi=lo+1;
