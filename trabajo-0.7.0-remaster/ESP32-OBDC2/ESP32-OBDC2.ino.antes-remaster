function gDib(){const c=$('gc'),x=c.getContext('2d'),W=c.width,Hh=c.height;x.clearRect(0,0,W,Hh);x.strokeStyle='#223';x.lineWidth=1;
for(let i=1;i<4;i++){x.beginPath();x.moveTo(0,Hh*i/4);x.lineTo(W,Hh*i/4);x.stroke()}
x.font='15px sans-serif';let ly=16;
