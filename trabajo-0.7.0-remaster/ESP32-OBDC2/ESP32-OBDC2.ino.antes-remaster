function norm(q){return q.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')}
function dato(id,j,cf){const p=cf.find(c=>c.id==id),v=(j&&j.d)?j.d[id]:null;return{p:p,v:v,t:(p&&v!=null)?cv(p,v).join(' '):null}}
function responder(q,j,cf,al,dt){q=norm(q);
if(/borr|elimin|limpi|reset|restabl|reinici|configur|cambi|apag/.test(q))return'Por seguridad no puedo borrar fallas ni cambiar la configuración por voz. Usa los botones de la pantalla.';
const D=id=>dato(id,j,cf),sin=n=>'Aún no tengo dato '+n+'.';
const uno=(id,n,txt)=>{const d=D(id);if(d.t==null)return sin(n);let r=txt+' '+d.t+'.';if(d.p.w>0&&d.v>=d.p.w)r+=' Está por encima de tu umbral de '+cv(d.p,d.p.w).join(' ')+'.';return r};
if(/resumen|todo|general|como va/.test(q)){const ps=[['rpm','RPM'],['vel','Velocidad'],['ect','Refrigerante'],['volt','Voltaje']].map(a=>[a[1],D(a[0]).t]).filter(a=>a[1]!=null).map(a=>a[0]+' '+a[1]);
let r=ps.length?ps.join(', ')+'.':'Todavía no tengo datos.';if(al&&al.n>0)r+=' Hay '+al.n+' alerta(s) activa(s).';return r}
if(/temperatura|calient|refriger|ect/.test(q))return uno('ect','de la temperatura del refrigerante','El refrigerante está a');
if(/rpm|revoluc|regimen/.test(q))return uno('rpm','de las RPM','El motor está a');
if(/volt|bateria/.test(q))return uno('volt','del voltaje','El voltaje es');
if(/carga|esfuerzo/.test(q))return uno('carga','de la carga del motor','La carga del motor es');
if(/velocidad|rapido|km/.test(q))return uno('vel','de la velocidad','Vas a');
if(/combustible|gasolina|tanque/.test(q))return uno('comb','del combustible','El nivel de combustible es');
if(/aceite/.test(q))return uno('oil','de la temperatura del aceite','El aceite está a');
if(/falla|codigo|dtc|check|mil/.test(q)){if(!dt||dt.cuenta==null)return'Aún no has leído las fallas. Pulsa "Leer fallas" y vuelve a preguntarme.';return'Según la última lectura: luz MIL '+(dt.mil?'encendida':'apagada')+' y '+dt.cuenta+' falla(s). Pulsa "Leer fallas" para ver los códigos.'}
if(/alerta|aviso|problema/.test(q)){if(!al)return'No pude consultar las alertas.';return al.n>0?'Alertas activas: '+al.a.map(x=>x.n+' '+x.t).join(', ')+'.':'No hay alertas activas.'}
if(/conexion|bluetooth|elm|conectado/.test(q))return j?'Estado: '+E[j.bt]+'.':'Sin enlace con el ESP32.';
return'No entendí. Prueba con: resumen, temperatura, RPM, voltaje, fallas, alertas o conexión.'}
