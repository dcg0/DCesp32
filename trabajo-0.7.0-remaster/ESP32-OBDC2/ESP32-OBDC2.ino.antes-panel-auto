static const float simRango[NPIDS][2] = {
  {800, 4500}, {0, 120}, {0, 80}, {15, 85}, {80, 102}, {30, 240}, {2, 40},
  {20, 45}, {13.5, 14.5}, {-8, 8}, {-5, 5}, {20, 80}, {85, 105}
