static void dcSim() {
  static uint32_t t = 0;
  if (millis() - t < 250) return;
  t = millis();
  float s = millis() / 1000.0f;
  for (uint8_t i = 0; i < NPIDS; i++) {
    float mid = (simRango[i][0] + simRango[i][1]) / 2, amp = (simRango[i][1] - simRango[i][0]) / 2;
    DCPids[i].valor = mid + amp * sinf(s / (2.0f + i));
    DCPids[i].valido = true; DCPids[i].soportado = true; DCPids[i].ts = millis();
  }
  dcBt = BT_LISTO; dcPps = 12;
}
#endif

void setup() {
  Serial.begin(115200);
  dcCfgBegin();
  WiFi.softAP(dcCfgSsid, dcCfgPass);
  Serial.print("Web: http://"); Serial.println(WiFi.softAPIP());
  server.on("/", []() { server.send_P(200, "text/html", PAGINA); });
  server.on("/logo.webp", []() { server.sendHeader("Cache-Control", "max-age=86400"); server.send_P(200, "image/webp", (PGM_P)logo_web_data, logo_web_len); });
  server.on("/portada.webp", []() { server.sendHeader("Cache-Control", "max-age=86400"); server.send_P(200, "image/webp", (PGM_P)portada_web_data, portada_web_len); });
  server.on("/data", []() { server.send(200, "application/json", dcJson()); });
  server.on("/status", []() { server.send(200, "application/json", dcStatusJson()); });
  server.on("/cfg", []() { server.send(200, "application/json", dcCfgJson()); });
  server.on("/dtc", HTTP_GET, []() { server.send(200, "application/json", dcDtcJson()); });
  server.on("/dtc/leer", HTTP_POST, []() { dcDtcIniciar(); server.send(202, "application/json", "{\"aceptado\":true}"); });
  server.on("/dtc/borrar", HTTP_POST, []() { String body=server.arg("plain"); if(!dcDtcBorrar(body)){server.send(400,"application/json","{\"error\":\"confirmacion requerida: confirmar=BORRAR\"}");return;} server.send(202,"application/json","{\"aceptado\":true}"); });
  server.on("/vehiculo", HTTP_GET, []() { server.send(200, "application/json", dcVehiculoJson()); });
  server.on("/vehiculo/leer", HTTP_POST, []() { dcVinIniciar(); server.send(202, "application/json", "{\"aceptado\":true}"); });
  // --- Fase 14 (configuración) y Fase 9 (alertas) ---
  server.on("/config", HTTP_GET, []() { server.send(200, "application/json", dcCfgEstadoJson()); });
  server.on("/config", HTTP_POST, []() {
    String e;
    if (!dcCfgGuardar([](const String& k) { return server.arg(k); }, e)) { server.send(400, "text/plain", "Error: " + e); return; }
    server.send(200, "text/plain", "Guardado. Si cambiaste WiFi o adaptador, reinicia el ESP32.");
  });
  server.on("/config/reset", HTTP_POST, []() {
    if (server.arg("confirmar") != "RESTABLECER") { server.send(400, "text/plain", "Error: confirmacion requerida"); return; }
    dcCfgReset();
    server.send(200, "text/plain", "Valores de fabrica restaurados. Reinicia el ESP32.");
  });
  server.on("/reiniciar", HTTP_POST, []() { server.send(200, "text/plain", "Reiniciando..."); delay(300); ESP.restart(); });
  server.on("/alertas", HTTP_GET, []() { server.send(200, "application/json", dcAlertJson()); });
  server.begin();
#ifndef SIMULATOR
  dcObdBegin();
#else
  dcPref.begin("dcobd", false);
  for (uint8_t i=0;i<4;i++) dcQ[i].estado=PQ_LIBRE;
#endif
  dcVinBegin();
#ifdef SIMULATOR
  dcEjecutarPruebasParsers();
#endif
}

void loop() {
  server.handleClient();
#ifdef SIMULATOR
  dcSim();
  if (dcBt == BT_LISTO) { dcSiguientePuntual(); dcObdSimPuntuales(); }
#else
  dcObdLoop();
#endif
  dcDtcTick();
  dcDtcTickBorrado();
  dcVinTick();
  dcAlertTick();
}
